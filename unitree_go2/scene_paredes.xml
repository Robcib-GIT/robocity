<mujoco model="go2 scene">
  <include file="go2.xml"/>

  <statistic center="0 0 0.1" extent="0.8"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="-130" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.9 0.9 0.9 1" reflectance="0.0"/>
  </asset>


  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- ========================================== -->
    <!--     LABERINTO DENSO (Pasillos 1.5m max)    -->
    <!-- ========================================== -->

    <!-- PAREDES EXTERIORES (Perímetro 10x10) -->
    <geom name="wall_south" type="box" pos="5.0 0.0 0.5" size="5.1 0.1 0.5" material="wall_mat"/>
    <geom name="wall_north" type="box" pos="5.0 10.0 0.5" size="5.1 0.1 0.5" material="wall_mat"/>
    <geom name="wall_west"  type="box" pos="0.0 5.0 0.5" size="0.1 5.0 0.5" material="wall_mat"/>
    <geom name="wall_east"  type="box" pos="10.0 5.0 0.5" size="0.1 5.0 0.5" material="wall_mat"/>

    <!-- ========================================== -->
    <!-- PAREDES HORIZONTALES                       -->
    <!-- Separadas exactamente 1.5m en el eje Y     -->
    <!-- ========================================== -->
    
    <!-- Fila 1 (Y=1.5) -->
    <geom name="h1_a" type="box" pos="2.25 1.5 0.5" size="2.25 0.1 0.5" material="wall_mat"/>
    <geom name="h1_b" type="box" pos="7.5 1.5 0.5"  size="1.0 0.1 0.5"  material="wall_mat"/>
    
    <!-- Fila 2 (Y=3.0) -->
    <geom name="h2_a" type="box" pos="3.5 3.0 0.5"  size="2.0 0.1 0.5" material="wall_mat"/>
    <geom name="h2_b" type="box" pos="8.5 3.0 0.5"  size="1.5 0.1 0.5" material="wall_mat"/>

    <!-- Fila 3 (Y=4.5) -->
    <geom name="h3_a" type="box" pos="1.5 4.5 0.5"  size="1.5 0.1 0.5" material="wall_mat"/>
    <geom name="h3_b" type="box" pos="7.25 4.5 0.5" size="2.75 0.1 0.5" material="wall_mat"/>

    <!-- Fila 4 (Y=6.0) -->
    <geom name="h4_a" type="box" pos="4.25 6.0 0.5" size="2.75 0.1 0.5" material="wall_mat"/>

    <!-- Fila 5 (Y=7.5) -->
    <geom name="h5_a" type="box" pos="2.25 7.5 0.5" size="2.25 0.1 0.5" material="wall_mat"/>
    <geom name="h5_b" type="box" pos="8.0 7.5 0.5"  size="2.0 0.1 0.5" material="wall_mat"/>

    <!-- Fila 6 (Y=9.0) -->
    <geom name="h6_a" type="box" pos="5.0 9.0 0.5"  size="3.5 0.1 0.5" material="wall_mat"/>

    <!-- ========================================== -->
    <!-- PAREDES VERTICALES                         -->
    <!-- Para forzar giros de 90 grados y bloqueos  -->
    <!-- ========================================== -->
    

    <geom name="v2" type="box" pos="3.0 2.25 0.5" size="0.1 0.75 0.5" material="wall_mat"/>

  </worldbody>
</mujoco>
