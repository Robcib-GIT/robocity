    <geom name="h1_b" type="box" pos="7.5 1.5 0.5"  size="1.0 0.1 0.5"  material="wall_mat"/>
    <geom name="h2_a" type="box" pos="3.5 3.0 0.5"  size="2.0 0.1 0.5" material="wall_mat"/>
